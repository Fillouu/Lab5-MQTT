
<!--
    @file      index.ejs
    @author    Felix Gladu
    @version   1.1
    @date      13 octobre 2026
    @brief     Affiche la liste des items et permet
               l'ajout d'un nouvel item.
-->

<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head') %>
</head>

<body>

    <%- include('../partials/header') %>

    <main>

        <h2>Gestion des items</h2>

        <!-- Affichage des messages d'erreur -->
        <% if (erreur) { %>
            <div class="message-erreur">
                <%= erreur %>
            </div>
        <% } %>

        <!-- Formulaire d'ajout -->
        <section class="formulaire-section">

            <h3>Ajouter un item</h3>

            <form action="/ajouter" method="POST">

                <div class="form-group">
                    <label for="nom">Nom de l'item :</label>
                    <input
                        type="text"
                        id="nom"
                        name="nom"
                        placeholder="Ex. : Clavier"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="prix">Prix ($) :</label>
                    <input
                        type="number"
                        id="prix"
                        name="prix"
                        placeholder="Ex. : 49.99"
                        min="0"
                        step="0.01"
                        required
                    >
                </div>

                <button type="submit" class="btn-ajouter">
                    Ajouter l'item
                </button>

            </form>

        </section>

        
        <!-- Formulaire de suppression par ID -->
        <section class="formulaire-section">

            <h3>Supprimer un item par ID</h3>

            <form action="/supprimer/id" method="POST">

                <div class="form-group">
                    <label for="id">Identifiant de l'item :</label>

                    <input
                        type="number"
                        id="id"
                        name="id"
                        placeholder="Ex. : 3"
                        min="1"
                        step="1"
                        required
                    >
                </div>

                <button type="submit" class="btn-supprimer">
                    Supprimer l'item
                </button>

            </form>

        </section>


        <!-- Formulaire de suppression par nom -->
        <section class="formulaire-section">

            <h3>Supprimer un item par nom</h3>

            <form action="/supprimer/nom" method="POST">

                <div class="form-group">

                    <label for="nomSuppression">
                        Nom de l'item :
                    </label>

                    <input
                        type="text"
                        id="nomSuppression"
                        name="nom"
                        placeholder="Ex. : Clavier"
                        required
                    >

                </div>

                <button type="submit" class="btn-supprimer">
                    Supprimer par nom
                </button>

            </form>

        </section>


        <!-- Formulaire de modification d'un item -->
        <section class="formulaire-section">

            <h3>Modifier un item</h3>

            <form action="/modifier" method="POST">

                <!-- Identifiant de l'item -->
                <div class="form-group">
                    <label for="idModification">
                        ID de l'item :
                    </label>

                    <input
                        type="number"
                        id="idModification"
                        name="id"
                        placeholder="Ex. : 1"
                        min="1"
                        step="1"
                        required
                    >
                </div>

                <!-- Nouveau nom -->
                <div class="form-group">
                    <label for="nomModification">
                        Nouveau nom :
                    </label>

                    <input
                        type="text"
                        id="nomModification"
                        name="nom"
                        placeholder="Ex. : Clavier mécanique"
                        required
                    >
                </div>

                <!-- Nouveau prix -->
                <div class="form-group">
                    <label for="prixModification">
                        Nouveau prix ($) :
                    </label>

                    <input
                        type="number"
                        id="prixModification"
                        name="prix"
                        placeholder="Ex. : 79.99"
                        min="0"
                        step="0.01"
                        required
                    >
                </div>

                <!-- Bouton de modification -->
                <button type="submit" class="btn-modifier">
                    Modifier l'item
                </button>

            </form>

        </section>


        <!-- Tableau des items -->
        <section class="tableau-section">

            <h3>Liste des items</h3>

            <table id="tableau-items">
                
                <thead>
                    <tr>
                        <th data-type="nombre">ID</th>
                        <th data-type="date">Date de création</th>
                        <th data-type="texte">Nom</th>
                        <th data-type="nombre">Prix</th>
                    </tr>
                </thead>

                <tbody>
                    <% items.forEach(function(item) { %>
                        <tr>
                            <td data-sort="<%= item.id %>">
                                <%= item.id %>
                            </td>

                            <td data-sort="<%= new Date(item.dateCreation).getTime() %>">
                                <%= item.dateCreation.toLocaleString('fr-CA') %>
                            </td>

                            <td>
                                <%= item.nom %>
                            </td>

                            <td data-sort="<%= Number(item.prix) %>">
                                <%= Number(item.prix).toFixed(2) %> $
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

            <% if (items.length === 0) { %>
                <p>Aucun item dans la liste.</p>
            <% } %>

        </section>

    </main>


    <%- include('../partials/footer') %>

    <!-- Bibliothèque cliente Socket.io -->
    <script src="/socket.io/socket.io.js"></script>

    <!-- Notre script Socket.io -->
    <script src="/scripts/socket.js"></script>

    <script src="/scripts/triTableau.js"></script>

</body>
</html>