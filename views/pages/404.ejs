<!--
 * @file      404.ejs
 * @author    Felix Gladu
 * @version   1.0
 * @date      14 octobre 2026
 * @brief     Affiche une page d'erreur personnalisée
 *            lorsqu'une URL demandée est inexistante.
 *            Propose un lien de retour à l'accueil.
 */
-->
 
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Erreur 404 - Page introuvable</title>

    <link rel="stylesheet"
          href="/stylesheets/style.css">
</head>

<body>

    <main class="page-erreur">

        <div class="erreur-contenu">

            <h1>404</h1>

            <h2>Page introuvable</h2>

            <p>
                Désolé, la page que vous recherchez
                n'existe pas ou a été déplacée.
            </p>

            <a href="/" class="btn-retour">
                Retour à l'accueil
            </a>

        </div>

    </main>

</body>
</html>
